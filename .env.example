# Optional cloud sync (private GitHub repo). Without these the app works fully offline.
# GITHUB_TOKEN=github_pat_xxx          # fine-grained, Contents: read & write, data repo only
# DATA_REPO=owner/myagenda-data         # must be PRIVATE
# SESSION_SECRET=                       # openssl rand -base64 32
# DATA_BRANCH=main                      # optional
#
# Rules for the future backend (FastAPI + PostgreSQL):
#  - Only variables prefixed NEXT_PUBLIC_ are exposed to the browser bundle. Never put secrets there.
#  - API keys, DB credentials and session secrets belong on the backend server only.
#  - Set values in Vercel → Project → Settings → Environment Variables, never commit a real .env file.
#
# Example (public, safe to expose):
# NEXT_PUBLIC_API_BASE_URL=https://api.example.az
